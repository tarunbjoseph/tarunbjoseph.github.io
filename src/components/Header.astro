---
import { person } from "../data/site";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const nav = [
  { href: "#work", label: "Work" },
  { href: "#experience", label: "Experience" },
  { href: "#background", label: "Background" },
  { href: "#contact", label: "Contact" },
];
---
<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5 sm:px-8">
    <a href="#top" class="font-serif text-xl font-medium tracking-tight text-ink no-underline">Tarun Joseph</a>
    <nav aria-label="Main" class="hidden items-center gap-7 text-sm text-muted md:flex">
      {nav.map((n) => <a href={n.href} class="no-underline transition-colors hover:text-ink">{n.label}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <button data-theme-toggle type="button" class="grid h-9 w-9 place-items-center rounded-full text-muted transition-colors hover:bg-accent-soft hover:text-ink" aria-label="Switch colour theme">
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" /></svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <a href={`${base}/${person.resume}`} class="hidden rounded-full border border-ink/80 px-4 py-1.5 text-sm font-medium text-ink no-underline transition-colors hover:bg-ink hover:text-paper sm:inline-block">Resume</a>
      <button data-menu-toggle type="button" class="grid h-9 w-9 place-items-center rounded-full text-ink md:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" hidden class="border-t border-line bg-paper md:hidden">
    <nav aria-label="Mobile" class="mx-auto flex max-w-5xl flex-col px-5 py-3 text-base">
      {nav.map((n) => <a href={n.href} class="py-2.5 text-ink no-underline">{n.label}</a>)}
      <a href={`${base}/${person.resume}`} class="py-2.5 text-accent no-underline">Resume (PDF)</a>
    </nav>
  </div>
</header>
