---
// Illustration of the OSPREY check flow. No numbers and no live data: it only shows the order of checks.
const rows = [
  { event: "A user sends a message", check: "Prompt screen", by: "Fine-tuned small language model" },
  { event: "The agent calls a tool", check: "Policy rules", by: "Open Policy Agent" },
  { event: "The tool sends back its output", check: "Detector, then attack classifier", by: "Fine-tuned small language model" },
];
const verdicts = [
  { name: "PASS", text: "Carry on" },
  { name: "ESCALATE", text: "Ask a person" },
  { name: "QUARANTINE", text: "Stop and isolate" },
];
---
<figure aria-label="How each agent step is checked">
  <div class="space-y-3">
    {rows.map((r, i) => (
      <div class="grid grid-cols-[1fr_auto_1fr] items-stretch gap-2 sm:gap-3">
        <div class="mon-on rounded-md px-3.5 py-3" style={`--i:${i}`}>
          <p class="text-[0.68rem] font-medium uppercase tracking-[0.12em] text-muted">Agent</p>
          <p class="mt-0.5 text-[0.95rem] leading-snug text-ink">{r.event}</p>
        </div>
        <svg class="mon-arrow h-5 w-5 self-center" style={`--i:${i}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
        <div class="mon-on rounded-md px-3.5 py-3" style={`--i:${i}`}>
          <p class="text-[0.68rem] font-medium uppercase tracking-[0.12em] text-muted">Check</p>
          <p class="mt-0.5 text-[0.95rem] leading-snug font-medium text-ink">{r.check}</p>
          <p class="mt-0.5 text-xs text-muted">{r.by}</p>
        </div>
      </div>
    ))}
  </div>
  <div class="mx-auto my-2 h-5 w-px bg-line" aria-hidden="true"></div>
  <div class="rounded-md border border-line p-3">
    <p class="text-[0.68rem] font-medium uppercase tracking-[0.12em] text-muted">Every check returns one verdict</p>
    <div class="mt-2 grid grid-cols-3 gap-2">
      {verdicts.map((v, i) => (
        <div class="mon-on rounded-md px-2 py-2 text-center" style={`--i:${i}`}>
          <p class="text-[0.7rem] font-semibold tracking-wide text-ink sm:text-sm">{v.name}</p>
          <p class="mt-0.5 text-xs text-muted">{v.text}</p>
        </div>
      ))}
    </div>
  </div>
  <figcaption class="mt-3 text-xs text-muted">An illustration of the order of checks. The animation cycles through the verdicts; it is not live data.</figcaption>
</figure>
