---
import type { CaseStudy } from "../data/site";
import Flow from "./Flow.astro";
import Monitor from "./Monitor.astro";
import LogoPlate from "./LogoPlate.astro";
interface Props { item: CaseStudy; }
const { item: c } = Astro.props;
---
<article class="reveal rounded-xl border border-line bg-card p-6 sm:p-8 md:p-10">
  <div class="grid gap-10 md:grid-cols-12">
    <div class="md:col-span-5">
      {c.logos && (
        <div class="mb-4 flex flex-wrap items-center gap-2">
          {c.logos.map((l) => <LogoPlate src={l.src} alt={l.alt} url={l.url} size={l.square ? "h-14 w-14" : "h-10 w-24"} bare={l.square} />)}
        </div>
      )}
      <p class="text-xs font-medium uppercase tracking-[0.12em] text-muted">{c.context}</p>
      <h3 class="mt-2 font-serif text-3xl leading-tight font-medium tracking-tight text-ink">{c.title}</h3>
      <p class="mt-3 flex flex-wrap items-center gap-2 text-xs text-muted">
        <span class="tabular-nums">{c.year}</span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-line px-2.5 py-0.5">
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
          {c.why}
        </span>
      </p>
      <p class="mt-5 text-[1.05rem] leading-relaxed text-ink">{c.problem}</p>
      <ul class="mt-4 space-y-2.5 leading-relaxed text-muted">
        {c.did.map((d) => <li class="relative pl-5 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2.5 before:bg-muted/60">{d}</li>)}
      </ul>
      {c.result && <p class="mt-5 border-l-2 border-accent pl-3 font-medium text-ink">{c.result}</p>}
      {c.link && (
        <a href={c.link.href} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-accent underline decoration-accent/40 hover:decoration-accent">
          {c.link.label}
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
        </a>
      )}
    </div>
    <div class="md:col-span-7 md:pl-4">
      {c.diagram === "monitor" ? <Monitor /> : c.steps && <Flow steps={c.steps} label={`How ${c.title} works`} />}
    </div>
  </div>
</article>
