---
import type { Project } from "../data/site";
interface Props { project: Project; index: number; }
const { project: p, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const flip = index % 2 === 1;
---
<article class="reveal grid items-start gap-8 md:grid-cols-12 md:gap-12">
  <a
    href={p.links[0].href}
    target="_blank"
    rel="noopener noreferrer"
    class:list={["shot-frame block overflow-hidden rounded-lg border border-line bg-card md:col-span-7", flip && "md:order-2"]}
    aria-label={`${p.links[0].label}: ${p.title}`}
  >
    <div class="flex items-center gap-1.5 border-b border-line px-3 py-2" aria-hidden="true">
      <span class="h-2 w-2 rounded-full bg-line"></span>
      <span class="h-2 w-2 rounded-full bg-line"></span>
      <span class="h-2 w-2 rounded-full bg-line"></span>
      <span class="ml-2 truncate text-[0.7rem] text-muted">{p.links[0].href.replace("https://", "")}</span>
    </div>
    <img
      src={`${base}/${p.image}`}
      alt={p.imageAlt}
      width="1200"
      height="750"
      loading="lazy"
      decoding="async"
      class="aspect-[16/10] w-full object-cover object-top"
    />
  </a>
  <div class:list={["md:col-span-5", flip && "md:order-1"]}>
    <p class="text-xs font-medium uppercase tracking-[0.12em] text-muted">{p.context} · {p.year}</p>
    <h3 class="mt-2 font-serif text-3xl leading-tight font-medium tracking-tight text-ink">{p.title}</h3>
    <p class="mt-3 text-[1.05rem] leading-relaxed text-ink">{p.oneLiner}</p>
    <p class="mt-3 leading-relaxed text-muted">{p.summary}</p>

    <details class="mt-5 border-t border-line pt-4">
      <summary class="flex items-center gap-2 text-sm font-medium text-ink">
        <svg class="chev h-3.5 w-3.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        How it works
      </summary>
      <ul class="mt-3 space-y-2.5 text-[0.95rem] leading-relaxed text-muted">
        {p.how.map((h) => <li class="border-l-2 border-line pl-3">{h}</li>)}
      </ul>
    </details>

    <ul class="mt-5 flex flex-wrap gap-1.5 text-xs text-muted" aria-label="Tools">
      {p.tools.map((t) => <li class="rounded-full border border-line px-2.5 py-1">{t}</li>)}
    </ul>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      {p.links.map((l, i) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            "inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-medium no-underline transition-colors",
            i === 0 ? "bg-ink text-paper hover:bg-accent" : "border border-line text-ink hover:border-ink",
          ]}
        >
          {l.label}
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
        </a>
      ))}
    </div>
    {p.note && <p class="mt-3 text-xs text-muted">{p.note}</p>}
  </div>
</article>
